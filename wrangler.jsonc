// Cloudflare deployment: the static site in dist/ plus the Worker in server/
// for opt-in features. Build with `npm run build:cloudflare` first.
// `npm run cf:dev` runs all of it on this machine with a local database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgekit",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages go through the Worker so page loads can be counted; the engine
    // files go through it because they are stored compressed (see server/assets.ts).
    // The extensionless paths are where those .html files redirect. A direct
    // visit has to be listed here or the Worker never sees it.
    "run_worker_first": ["/api/*", "/", "/*.html", "/guide", "/method", "/privacy", "/price-volume-mix-analysis", "/grouping-level", "/app/*", "/assets/*.wasm"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bridgekit",
      // Replaced with the real id after `wrangler d1 create bridgekit`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "dev": { "port": 8790, "ip": "127.0.0.1" },
  // ACCOUNTS is a Worker variable. Account, workspace, payment, and commentary
  // routes run only when its value is the exact string on. This file does not
  // set it. Missing, empty, and any other value leave those routes off.
  //
  // LOCAL_EMAIL_LOG is a Worker variable. It is on only when its value is the
  // exact string on. This file does not set it. Local development sets it, so
  // with no mail key an email is written to the Worker log. Missing, empty, and
  // any other value mean a missing mail key is an error.
  "vars": {
    // Replaced with the real address in production.
    "BETTER_AUTH_URL": "http://localhost:8790"
  },
  "ratelimits": [
    {
      "name": "MAGIC_LINK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "COMMENTARY_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // Secrets, set with `wrangler secret put NAME` (or .dev.vars locally):
  // BETTER_AUTH_SECRET, ANTHROPIC_API_KEY, RESEND_API_KEY, EMAIL_FROM,
  // MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET, PADDLE_PRICE_ID
}
